<%# app/views/list_items/_list_item.html.erb %>
<li data-id="<%= list_item.id %>" 
    class="rounded-lg shadow-sm transition-all hover:shadow-md <%= list_item.is_link? ? 'border-3 border-dashed' : 'border border-gray-200' %>"
    style="<%= list_item.inline_style %>">
    <!-- Contenuto dell'item con colori applicati -->
  <div class="flex items-center rounded-lg p-4 gap-3" style="<%= list_item.inline_style %>">
 
    <!-- Handle per il drag -->
    <div class="drag-handle cursor-move text-gray-400 hover:text-gray-600 transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M7 2a2 2 0 1 1 .001 4.001A2 2 0 0 1 7 2zM7 8a2 2 0 1 1 .001 4.001A2 2 0 0 1 7 8zM7 14a2 2 0 1 1 .001 4.001A2 2 0 0 1 7 14zM13 2a2 2 0 1 1 .001 4.001A2 2 0 0 1 13 2zM13 8a2 2 0 1 1 .001 4.001A2 2 0 0 1 13 8zM13 14a2 2 0 1 1 .001 4.001A2 2 0 0 1 13 14z"></path>
      </svg>
    </div>
    
    <!-- Pulsante Expand/Collapse con persistenza database -->
    <% if list_item.children.any? %>
      <button class="collapse-btn w-5 h-5 flex items-center justify-center text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded transition-colors"
              data-action="click->collapse#toggleWithPersistence"
              data-item-id="<%= list_item.id %>"
              data-target-id="children-<%= list_item.id %>"
              title="Espandi/Comprimi">
        <svg class="w-4 h-4 transform transition-transform duration-200 <%= list_item.expanded? ? '' : 'rotate-[-90deg]' %>" 
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    <% else %>
      <div class="w-5 h-5 collapse-spacer"></div>
    <% end %>
    
    <!-- Resto del contenuto invariato -->
    <div class="flex-1">
      <div class="flex items-center gap-2">
        <!-- Numero automatico con background che contrasta -->
        <span class="item-number" style="background: <%= list_item.text_color || '#374151' %>; color: <%= list_item.background_color || '#ffffff' %>;"></span>
                
        <div class="flex-1">
          <div class="md:flex md:items-center md:gap-3">
             <!-- Titolo con colore del testo -->
            <h3 class="font-semibold text-lg md:flex-shrink-0" style="color: <%= list_item.text_color || '#374151' %>;">
              <%= list_item.display_title %>
            </h3>            
            <% if list_item.content.present? %>
              <div class="md:hidden">
                <button class="text-gray-400 hover:text-gray-600 ml-2 p-1" 
                        onclick="this.nextElementSibling.classList.toggle('hidden')"
                        title="Mostra/nascondi descrizione">
                  👁️
                </button>
                <p class="text-sm mt-2 hidden opacity-80" style="color: <%= list_item.text_color || '#374151' %>;">
                  <%= list_item.content %>
                </p>
              </div>
              
              <div class="hidden md:block flex-1">
                <span class="text-gray-400 mx-2">•</span>
               <span class="text-sm opacity-80" style="color: <%= list_item.text_color || '#374151' %>;">
                  <%= truncate(list_item.content, length: 100) %>
                </span>              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Azioni compatte invariate -->
    <div class="flex items-center gap-1">

      <% if list_item.can_have_children? %>
           <button onclick="window.location.href='/list_items/new?parent_id=<%= list_item.id %>'" 
              class="w-7 h-7 flex items-center justify-center text-green-600 hover:text-green-700 hover:bg-green-50 rounded-full transition-colors"
              title="Aggiungi sotto-elemento">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
        </svg>
           </button>
         <% end %>
            <% if list_item.is_link? %>
  <!-- Se è già un link, mostra dove punta -->
  <%= link_to show_link_path(list_item),
      data: { turbo: "false" },
      class: "w-7 h-7 flex items-center justify-center text-purple-600 hover:text-purple-700 hover:bg-purple-50 rounded-full transition-colors",
      title: "Vai al collegamento: #{list_item.linked_item&.title}" do %>
    🔗
  <% end %>

   <%= link_to edit_list_item_path(list_item),
         data: { turbo: "false" },
          class: "w-7 h-7 flex items-center justify-center text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-full transition-colors",
          title: "Modifica" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>

  
  <!-- Pulsante per rimuovere link -->
  <%= button_to destroy_link_path(list_item),
      method: :delete,
      data: { turbo_confirm: "Rimuovere il collegamento?" },
      class: "w-7 h-7 flex items-center justify-center text-red-600 hover:text-red-700 hover:bg-red-50 rounded-full transition-colors border-none bg-transparent p-0",
      title: "Rimuovi collegamento" do %>
    ⛓️‍💥
  <% end %>
<% else %>

      <%= link_to list_item_path(list_item),
          data: { turbo: "false" },
          class: "w-7 h-7 flex items-center justify-center text-gray-600 hover:text-gray-700 hover:bg-gray-50 rounded-full transition-colors",
          title: "Visualizza" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
      <% end %>
      <%= link_to edit_list_item_path(list_item),
         data: { turbo: "false" },
          class: "w-7 h-7 flex items-center justify-center text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-full transition-colors",
          title: "Modifica" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>
      
      <%= button_to list_item_path(list_item),
      method: :delete,
      data: { 
        turbo_confirm: "Sicuro di voler eliminare questo elemento? I sotto-elementi saranno spostati al livello superiore."
      },
      class: "w-7 h-7 flex items-center justify-center text-red-600 hover:text-red-700 hover:bg-red-50 rounded-full transition-colors border-none bg-transparent p-0",
      title: "Elimina" do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
  </svg>
<% end %> 

<% end %>
    </div>
  </div>
  
  <!-- Sotto-elementi con stato dal database -->
  <% if list_item.children.any? %>
    <div id="children-<%= list_item.id %>" 
         class="collapsible-content ml-4 pb-2 <%= list_item.expanded? ? '' : 'collapsed' %>">
      <ul data-sortable-target="list" 
          data-parent-id="<%= list_item.id %>"
          class="space-y-2 pl-2">
        <%= render partial: "list_item", collection: list_item.children.reorder(Arel.sql("COALESCE(position,0) ASC, id ASC")) %>
      </ul>
    </div>
  <% else %>
    <ul data-sortable-target="list" 
        data-parent-id="<%= list_item.id %>"
        class="space-y-2 pl-2">
      <li></li>
    </ul>
  <% end %>
</li>
